# Pins what EDITORS write to disk. .gitattributes pins what GIT produces
# (LF checkouts); this file covers the one path git's filters cannot reach.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[*.{json,yml,yaml,mjs,js}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
